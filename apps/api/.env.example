# БД: локальный Homebrew PostgreSQL, порт 5433. trust-авторизация → без пароля.
# Запуск: pg_ctl -D /opt/homebrew/var/postgresql@18 -o "-p 5433" start
DATABASE_URL="postgresql://<user>@localhost:5433/heartwood?schema=public"

# Порт API (Next.js занимает 3000)
PORT=3001

# Разрешённый origin фронта
CORS_ORIGIN="http://localhost:3000"

# Секрет подписи JWT. Сменить в проде!
JWT_SECRET="change-me-in-production"

# Срок жизни токена доступа (секунды). 30 дней.
JWT_EXPIRES_IN=2592000
